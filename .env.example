# Database Connection URL (MySQL)
DATABASE_URL=mysql://username:password@hostname:port/database?ssl-mode=REQUIRED

# JWT / Cookie Session Secret
JWT_SECRET=your_jwt_cookie_secret_key_here

# Admin User Initialization (Used during database seeding on startup)
ADMIN_INITIAL_PASSWORD=your_secure_initial_admin_password_here

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI Config
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Maps Config
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Analytics Config (Optional)
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
